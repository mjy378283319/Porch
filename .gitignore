# ---------- 依赖 / 构建产物 ----------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/tmp/
frontend/*.tsbuildinfo
backend/build/
backend/flatnas-backend
backend/flatnas-server
backend/flatnas-*
*.exe

# Windows 本地开发时 vite 把产物直接写进 server/public，不入库
server/public/*
!server/public/.gitkeep

# ---------- 运行期数据（用户数据，绝不入库） ----------
server/data/*
!server/data/.gitkeep
server/doc/*
!server/doc/.gitkeep
server/music/*
!server/music/.gitkeep
server/PC/*
!server/PC/.gitkeep
server/APP/*
!server/APP/.gitkeep

# ---------- 环境与密钥 ----------
.env
.env.*
!.env.example
*.key

# ---------- 日志 / 临时 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.zip
*.tar.gz
.DS_Store
Thumbs.db
Desktop.ini
.fnsync_temp_dir/

# API 推送脚本的临时文件
_msg.txt
api_push.log
