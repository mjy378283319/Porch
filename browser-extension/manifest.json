{
  "name": "Porch 专用助手",
  "version": "3.3",
  "manifest_version": 3,
  "description": "仅在指定的 NAS 地址解除 iframe 限制，并提供右键菜单发送功能。",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/logo.png",
    "48": "assets/logo.png",
    "128": "assets/logo.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "设置 Porch 地址",
    "default_icon": "assets/logo.png"
  },
  "commands": {
    "quick-add-bookmark": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "一键添加当前页到 Porch"
    }
  }
}
